PROJECT_NAME=vhdutils

# Try to auto-detect VISUALSTUDIOVERSION if not specified
CPPVER_DEFAULT=$(VISUALSTUDIOVERSION:.=)
# 110 - Visual Studio 2012
# 120 - Visual Studio 2013
# 140 - Visual Studio 2015
# 150 - Visual Studio 2017
# 160 - Visual Studio 2019
# 170 - Visual Studio 2022

# Try to auto-detect ARCH if not specified, matching the current environment
!IFNDEF ARCH
!IF "$(PLATFORM)" == "X64" || "$(PLATFORM)" == "x64"
ARCH_DEFAULT=x64
!ELSEIFDEF VSCMD_ARG_TGT_ARCH
!IF "$(VSCMD_ARG_TGT_ARCH)" == "x64" || "$(VSCMD_ARG_TGT_ARCH)" == "amd64"
ARCH_DEFAULT=x64
!ELSEIF "$(VSCMD_ARG_TGT_ARCH)" == "x86"
ARCH_DEFAULT=x86
!ELSE
ARCH_DEFAULT=x64
!ENDIF
!ELSE
!IF [cmd /c "echo %LIB% | findstr /i "amd64" > nul"] == 0
ARCH_DEFAULT=x64
!ELSE
ARCH_DEFAULT=x86
!ENDIF
!ENDIF
!ENDIF

################################################################################
# Adjustable configuration
################################################################################

# Standard version-specific compiler options
!IFNDEF ARCH
ARCH=$(ARCH_DEFAULT)
!ENDIF

# Standard version-specific compiler options
!IFNDEF CPPVER
CPPVER=$(CPPVER_DEFAULT)
!ENDIF

# File extension of our desired target
TARGET_EXTENSION=exe

# Output and intermediate directories
BINDIR=build/bin/$(ARCH)
OBJDIR=build/obj/$(ARCH)

# Additional include directories
CPPFLAGS_INC=
# Additional definitions
CPPFLAGS_DEF_EX=

# Linker output type: Subsystem
LINKFLAGS_SUB=CONSOLE


# Additional library paths
LINK_LIBPATHS= \
	/LIBPATH:lib\$(ARCH)

# Import libraries
!IF "$(CPPVER)" == "140"
LINK_LIBS= \
	kernel32.lib \
	shell32.lib \
	virtdisk.lib \
	ucrt.lib \
	vcruntime.lib \
	legacy_stdio_wide_specifiers.lib
!ELSE
LINK_LIBS= \
	kernel32.lib \
	shell32.lib \
	virtdisk.lib
!ENDIF

# Target definitions
TARGET_1="$(BINDIR)\makevhd.$(TARGET_EXTENSION)"
LINK_OBJS_1= \
	"$(OBJDIR)\makevhd.obj" \
	"$(OBJDIR)\EntryPoint.obj" \
	"$(OBJDIR)\ParseUnsignedInteger.obj" \
	"$(OBJDIR)\CalculateGeometry.obj" \
	"$(OBJDIR)\RoundToCHSSize.obj" \
	"$(OBJDIR)\SetVhdMaximumGeometry.obj" \
	"$(OBJDIR)\UpdateVhdFooterAt.obj"

TARGET_2="$(BINDIR)\resizevhd.$(TARGET_EXTENSION)"
LINK_OBJS_2= \
	"$(OBJDIR)\resizevhd.obj" \
	"$(OBJDIR)\EntryPoint.obj" \
	"$(OBJDIR)\ParseUnsignedInteger.obj"

!IF "$(ARCH)" == "x86"
ARCH_DEF=_M_IX86
ARCH_LNK=IX86
NTVER_DEF=0x0602
NTVER_LNK_1=6.1
NTVER_LNK_2=6.2
CPPFLAGS_EX=
LINKFLAGS_EX=
!ELSEIF "$(ARCH)" == "x64"
ARCH_DEF=_M_AMD64
ARCH_LNK=AMD64
NTVER_DEF=0x0602
NTVER_LNK_1=6.1
NTVER_LNK_2=6.2
CPPFLAGS_EX=
LINKFLAGS_EX=
!ELSE
!ERROR Unsupported or invalid ARCH="$(ARCH)". Valid values are x86 or x64.
!ENDIF

################################################################################
# Standard configuration
################################################################################

# Standard compiler options
CPPFLAGS_STD=/nologo /c /MD /W3 /GF /GR- /EHs-c- /O1
# Standard definitions
CPPFLAGS_DEF_STD=/D "WIN32" /D "NDEBUG" /D "_UNICODE" /D "UNICODE" /D "_WIN32_WINNT=$(NTVER_DEF)"

# Linker output type: DLL and .def
!IF "$(TARGET_EXTENSION)" == "dll"
LINKFLAGS_DLL=/DLL /DEF:"$(PROJECT_NAME).def"
!ENDIF

# Standard linker options (/OPT:NOWIN98 is implied by SUBSYSTEM version >= 5.0)
LINKFLAGS_STD=/NOLOGO /RELEASE /OPT:REF /OPT:ICF /MERGE:.rdata=.text /IGNORE:4078
# Target OS and machine options
LINKFLAGS_TARG_1=/SUBSYSTEM:$(LINKFLAGS_SUB),$(NTVER_LNK_1) /OSVERSION:$(NTVER_LNK_1) /MACHINE:$(ARCH_LNK)
LINKFLAGS_TARG_2=/SUBSYSTEM:$(LINKFLAGS_SUB),$(NTVER_LNK_2) /OSVERSION:$(NTVER_LNK_2) /MACHINE:$(ARCH_LNK)

# Code compiler
CPP=@cl.exe
CPPFLAGS=$(CPPFLAGS_STD) $(CPPFLAGS_EX) $(CPPFLAGS_INC) $(CPPFLAGS_DEF_STD) $(CPPFLAGS_DEF_EX)
CPPFLAGSOUT=$(CPPFLAGS) /Fo"$(OBJDIR)\\"

# Resource compiler
RC=@rc.exe
RFLAGS=/l 0x409 /d "NDEBUG" /d "$(ARCH_DEF)"

# Linker
LINK=@link.exe
LINKFLAGS_1=$(LINKFLAGS_STD) $(LINKFLAGS_DLL) $(LINKFLAGS_TARG_1) $(LINKFLAGS_EX) $(LINK_LIBPATHS) $(LINK_LIBS)
LINKFLAGS_2=$(LINKFLAGS_STD) $(LINKFLAGS_DLL) $(LINKFLAGS_TARG_2) $(LINKFLAGS_EX) $(LINK_LIBPATHS) $(LINK_LIBS)

################################################################################
# Recipes and rules
################################################################################

ALL : DEFAULT
DEFAULT : "$(BINDIR)" "$(OBJDIR)" $(TARGET_1) $(TARGET_2)

DIST : DEFAULT
	@if not exist "build\staging\bin" md "build\staging\bin"
	@if not exist "dist" md "dist"
	copy $(BINDIR:/=\)\* build\staging\bin 1>NUL
	cd build\staging & md5sum bin/* 1>"$(PROJECT_NAME).md5"
	copy README.md build\staging 1>NUL
	@echo off & for /f %%D in ('call build\date.bat') do \
	tar -caf "dist\$(PROJECT_NAME)-win-$(ARCH)-%%D.zip" -C build\staging *
	@if exist "build/staging" rmdir /s /q "build/staging"

clean:
	@if exist "build/bin" rmdir /s /q "build/bin"
	@if exist "build/obj" rmdir /s /q "build/obj"
	@del dist\* /q
	@touch dist\.gitignore

$(TARGET_1) : $(LINK_OBJS_1)
	$(LINK) @<<
	$(LINKFLAGS_1) $(LINK_OBJS_1) /OUT:$@
<<

$(TARGET_2) : $(LINK_OBJS_2)
	$(LINK) @<<
	$(LINKFLAGS_2) $(LINK_OBJS_2) /OUT:$@
<<

"$(BINDIR)" :
	-@md $@

"$(OBJDIR)" :
	-@md $@

.rc{$(OBJDIR)}.res:
	$(RC) $(RFLAGS) /Fo$@ $<

.c{$(OBJDIR)}.obj::
	$(CPP) @<<
	$(CPPFLAGSOUT) $<
<<

.cpp{$(OBJDIR)}.obj::
	$(CPP) @<<
	$(CPPFLAGSOUT) $<
<<

{src}.c{$(OBJDIR)}.obj::
	$(CPP) @<<
	$(CPPFLAGSOUT) $<
<<

{src}.cpp{$(OBJDIR)}.obj::
	$(CPP) @<<
	$(CPPFLAGSOUT) $<
<<
